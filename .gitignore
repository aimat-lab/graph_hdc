*slurm-*.out
*__pycache__*
tests/artifacts/*
.vscode

lightning_logs/
.identity.json
**/results/*
**/.cache/*
**/checkpoints/*

.rdkit
**/.aslurm/*

**/_*
# ...but always keep package __init__.py: the rule above matches names starting with
# '_', which would otherwise drop __init__.py from git and silently break fresh clones
# (e.g. graph_hdc/models/__init__.py, which exports HyperNet).
!**/__init__.py

**/experiments/**/*.png
**/experiments/**/*.pdf
**/experiments/**/*.csv
**/experiments/**/*.db
# Sherlock baseline corpus + fitted dictionary (large, not tracked)
data/sherlock/

# Molecular dataset files (downloaded via chem_mat_data, cached separately — not tracked)
*.mpack
